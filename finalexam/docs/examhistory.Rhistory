# =========================================================
plot_margin_with_runs <- function(tl, runs_tbl, game_name) {
p <- ggplot(tl, aes(x = game_min, y = margin)) +
geom_hline(yintercept = 0) +
geom_line() +
labs(
title = paste0(game_name, " — Score Margin (UC Davis minus Opponent)"),
x = "Game minutes elapsed",
y = "Margin"
)
if (nrow(runs_tbl) > 0) {
p <- p +
geom_rect(
data = runs_tbl,
aes(xmin = start_min, xmax = end_min, ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
alpha = 0.15
) +
geom_text(
data = runs_tbl,
aes(x = (start_min + end_min)/2, y = max(tl$margin, na.rm = TRUE),
label = paste0("OPP +", points)),
inherit.aes = FALSE,
vjust = -0.5,
size = 3
)
}
p
}
plot_run_causes <- function(all_runs) {
ggplot(all_runs, aes(x = reorder(cause, -points), y = points)) +
geom_col() +
coord_flip() +
labs(
title = "Opponent Run Causes (Aggregate)",
x = "Cause (heuristic)",
y = "Opponent run points"
)
}
plot_sub_activity_around_runs <- function(tl, runs_tbl, game_name) {
sub_pat <- regex("substitution|sub in|sub out|enters the game|leaves the game", ignore_case = TRUE)
subs <- tl %>%
filter(str_detect(event_text, sub_pat)) %>%
select(game_min, event_text)
if (nrow(subs) == 0 || nrow(runs_tbl) == 0) return(NULL)
ggplot() +
geom_rect(
data = runs_tbl,
aes(xmin = start_min, xmax = end_min, ymin = 0, ymax = 1),
alpha = 0.15
) +
geom_point(
data = subs,
aes(x = game_min, y = 0.5),
size = 2
) +
labs(
title = paste0(game_name, " — Substitution Events vs Opponent Runs"),
x = "Game minutes elapsed",
y = ""
) +
theme(axis.text.y = element_blank(),
axis.ticks.y = element_blank())
}
# =========================================================
# 7) Run everything
# =========================================================
all_runs <- list()
for (f in pdf_files) {
message("Processing: ", basename(f))
raw <- read_pdf_lines(f)
pbp <- filter_pbp_lines(raw)
if (nrow(pbp) < 20) {
message("  -> Not enough play-by-play-like lines detected; skipping.")
next
}
events <- parse_pbp_lines(pbp)
tl <- build_timeline(events)
det <- detect_opponent_runs(tl, min_points = RUN_MIN_POINTS, gap_max_seconds = GAP_MAX_SECONDS)
runs_tbl <- det$runs
runs_tbl <- tag_run_cause(tl, runs_tbl) %>%
mutate(game = tools::file_path_sans_ext(basename(f)))
all_runs[[basename(f)]] <- runs_tbl
# ---- Save charts per game
game_name <- tools::file_path_sans_ext(basename(f))
p1 <- plot_margin_with_runs(tl, runs_tbl, game_name)
ggsave(filename = file.path(OUT_DIR, paste0(game_name, "_margin_runs.png")),
plot = p1, width = 10, height = 5, dpi = 200)
p2 <- plot_sub_activity_around_runs(tl, runs_tbl, game_name)
if (!is.null(p2)) {
ggsave(filename = file.path(OUT_DIR, paste0(game_name, "_subs_vs_runs.png")),
plot = p2, width = 10, height = 3.2, dpi = 200)
}
# ---- Save run table per game
write_csv(runs_tbl, file.path(OUT_DIR, paste0(game_name, "_opponent_runs.csv")))
}
all_runs_df <- bind_rows(all_runs)
# Aggregate cause chart
if (nrow(all_runs_df) > 0) {
p_cause <- plot_run_causes(all_runs_df %>% group_by(cause) %>% summarize(points = sum(points), .groups="drop"))
ggsave(filename = file.path(OUT_DIR, "aggregate_opponent_run_causes.png"),
plot = p_cause, width = 10, height = 5.5, dpi = 200)
# Also export a single combined runs table
write_csv(all_runs_df, file.path(OUT_DIR, "ALL_opponent_runs.csv"))
}
message("Done. Outputs written to: ", OUT_DIR)
# =========================================================
# 8) How to interpret outputs
# =========================================================
# - *_margin_runs.png: margin timeline; shaded blocks = opponent runs (>= RUN_MIN_POINTS unanswered)
# - *_opponent_runs.csv: exact run windows (start/end minute), run points, margins, and heuristic cause
# - aggregate_opponent_run_causes.png: which causes account for the most opponent-run points
#
# If parsing misses events:
# - Look at `pbp <- filter_pbp_lines(raw)` and inspect `pbp$line[1:50]`
# - Then tweak patterns in `filter_pbp_lines()` and `parse_pbp_lines()`
# =========================================================
# ============================================
# UC DAVIS WBB — Opponent Run Visualizer (R)
# --------------------------------------------
# What this script does:
# 1) Reads NCAA-style Play-by-Play PDFs (pdftools)
# 2) Extracts event timeline: period, clock, team, points, score, margin
# 3) Detects opponent scoring runs (default: 6+ unanswered)
# 4) Creates charts:
#    A) Score margin vs time with opponent-run shading
#    B) Run causes (heuristic) bar chart (aggregate)
#    C) Optional: Substitution activity around runs (if subs appear in text)
#
# NOTE:
# Parsing play-by-play PDFs varies by vendor/format. This code is robust-ish,
# but you may need to tweak regex patterns in `filter_pbp_lines()` and `parse_pbp_lines()`.
# ============================================
# Packages
library(pdftools)
library(tidyverse)
library(stringr)
library(lubridate)
# ---------------------------
# User settings
# ---------------------------
TEAM_PATTERNS <- c("UC Davis", "UC-Davis", "UC DAVIS", "UCD", "Davis")  # adjust if needed
RUN_MIN_POINTS <- 6                 # opponent unanswered points threshold
GAP_MAX_SECONDS <- Inf              # keep as Inf; or set to 180 to force "runs" within 3 minutes
OUT_DIR <- "run_outputs"
dir.create(OUT_DIR, showWarnings = FALSE)
# Your PDFs (edit paths if needed)
pdf_files <- c(
"20251114093023-2769513.pdf",
"20251120111253-2721870.pdf",
"20251124110212-2722312.pdf",
"20251204100618-2682924.pdf",
"20251206100421-2704179.pdf",
"20251220060124-2682927.pdf"
)
# =========================================================
# 1) Helpers: read PDF -> isolate play-by-play-ish lines
# =========================================================
read_pdf_lines <- function(path) {
txt <- pdf_text(path)
lines <- txt %>%
str_split("\n") %>%
unlist() %>%
str_squish() %>%
discard(~ .x == "")
tibble(file = basename(path), line = lines)
}
# Keep only lines that look like play-by-play:
# - contain a clock like "9:32" or "00:45"
# - and contain either "Score" or a score pattern like "25-23"
filter_pbp_lines <- function(df) {
df %>%
filter(
str_detect(line, "\\b\\d{1,2}:\\d{2}\\b") &
(str_detect(line, "\\b\\d{1,3}\\s*[-–]\\s*\\d{1,3}\\b") |
str_detect(line, "Score") |
str_detect(line, "SCORE"))
)
}
# =========================================================
# 2) Parse play-by-play lines into structured events
# =========================================================
# Convert clock "MM:SS" to seconds remaining in period (assume 10-min quarters by default)
clock_to_sec <- function(clock) {
parts <- str_split(clock, ":", simplify = TRUE)
as.integer(parts[, 1]) * 60 + as.integer(parts[, 2])
}
# Guess period/quarter from line markers if present, else NA
guess_period <- function(line) {
# Common patterns: "1st", "2nd", "3rd", "4th", "Q1", "Q2", etc.
case_when(
str_detect(line, "\\b1(st)?\\b|\\bQ1\\b") ~ 1L,
str_detect(line, "\\b2(nd)?\\b|\\bQ2\\b") ~ 2L,
str_detect(line, "\\b3(rd)?\\b|\\bQ3\\b") ~ 3L,
str_detect(line, "\\b4(th)?\\b|\\bQ4\\b") ~ 4L,
TRUE ~ NA_integer_
)
}
# Extract: clock, score, and event text.
# We do NOT assume which side is UC Davis yet.
parse_pbp_lines <- function(df_lines) {
df_lines %>%
mutate(
clock = str_extract(line, "\\b\\d{1,2}:\\d{2}\\b"),
score_raw = str_extract(line, "\\b\\d{1,3}\\s*[-–]\\s*\\d{1,3}\\b"),
score_raw = str_replace_all(score_raw, "–", "-"),
s1 = as.integer(str_extract(score_raw, "^\\d{1,3}")),
s2 = as.integer(str_extract(score_raw, "\\d{1,3}$")),
period_guess = map_int(line, guess_period),
# Event text = remove clock + score from line
event_text = line %>%
str_remove("\\b\\d{1,2}:\\d{2}\\b") %>%
str_remove("\\b\\d{1,3}\\s*[-–]\\s*\\d{1,3}\\b") %>%
str_squish()
) %>%
filter(!is.na(clock), !is.na(score_raw), !is.na(s1), !is.na(s2)) %>%
mutate(clock_sec = clock_to_sec(clock))
}
# Determine whether an event belongs to UC Davis or opponent using TEAM_PATTERNS in event_text.
# IMPORTANT: fixed() does not support vector patterns; build a single OR regex.
tag_team <- function(event_text, team_patterns = TEAM_PATTERNS) {
pat <- regex(paste0("(", paste(team_patterns, collapse = "|"), ")"), ignore_case = TRUE)
is_team <- str_detect(event_text, pat)
ifelse(is_team, "UC_DAVIS", "OPP")
}
# =========================================================
# 3) Build event timeline with inferred scoring + margin
# =========================================================
# Infer which score column corresponds to UC Davis
infer_score_side <- function(df_events) {
df_events <- df_events %>%
mutate(team = tag_team(event_text)) %>%
arrange(period_guess %||% 1L, desc(clock_sec))
df1 <- df_events %>%
mutate(uc = s1, opp = s2) %>%
arrange(period_guess %||% 1L, desc(clock_sec)) %>%
mutate(uc_delta = uc - lag(uc)) %>%
summarize(uc_scoring_on_uc_lines = sum((team == "UC_DAVIS") & (uc_delta > 0), na.rm = TRUE))
df2 <- df_events %>%
mutate(uc = s2, opp = s1) %>%
arrange(period_guess %||% 1L, desc(clock_sec)) %>%
mutate(uc_delta = uc - lag(uc)) %>%
summarize(uc_scoring_on_uc_lines = sum((team == "UC_DAVIS") & (uc_delta > 0), na.rm = TRUE))
df1$uc_scoring_on_uc_lines >= df2$uc_scoring_on_uc_lines
}
build_timeline <- function(df_events, uc_is_s1 = NULL) {
if (is.null(uc_is_s1)) uc_is_s1 <- infer_score_side(df_events)
tl <- df_events %>%
mutate(team = tag_team(event_text)) %>%
mutate(period = period_guess) %>%
arrange(period %||% 1L, desc(clock_sec)) %>%
mutate(
uc_score  = if (uc_is_s1) s1 else s2,
opp_score = if (uc_is_s1) s2 else s1,
margin = uc_score - opp_score
) %>%
arrange(period %||% 1L, desc(clock_sec)) %>%
mutate(
uc_delta  = uc_score - lag(uc_score),
opp_delta = opp_score - lag(opp_score),
uc_delta  = replace_na(uc_delta, 0),
opp_delta = replace_na(opp_delta, 0)
)
# Approx "game seconds elapsed" for plot x-axis (10-min quarters)
tl <- tl %>%
mutate(
period2 = if_else(is.na(period), 1L, period),
game_sec = (period2 - 1) * 600 + (600 - clock_sec),
game_min = game_sec / 60
)
tl
}
# =========================================================
# 4) Detect opponent runs (unanswered points)
# =========================================================
detect_opponent_runs <- function(tl, min_points = RUN_MIN_POINTS, gap_max_seconds = GAP_MAX_SECONDS) {
tl <- tl %>% arrange(game_sec)
# Identify scoring events
sc <- tl %>%
mutate(
scorer = case_when(
opp_delta > 0 ~ "OPP",
uc_delta  > 0 ~ "UC_DAVIS",
TRUE ~ NA_character_
),
points = pmax(opp_delta, uc_delta, 0)
) %>%
filter(!is.na(scorer), points > 0)
if (nrow(sc) == 0) return(list(runs = tibble(), scoring = sc))
# Blocks are consecutive scoring by the same scorer; break also if time gap too large
sc <- sc %>%
mutate(
new_block = c(TRUE, scorer[-1] != scorer[-n()]) |
c(FALSE, (game_sec[-1] - game_sec[-n()]) > gap_max_seconds),
block_id = cumsum(new_block)
)
blocks <- sc %>%
group_by(block_id, scorer) %>%
summarize(
start_sec = first(game_sec),
end_sec   = last(game_sec),
start_min = first(game_min),
end_min   = last(game_min),
points    = sum(points),
start_margin = first(margin),
end_margin   = last(margin),
n_events = n(),
.groups = "drop"
) %>%
filter(scorer == "OPP", points >= min_points) %>%
mutate(run_id = row_number())
list(runs = blocks, scoring = sc)
}
# =========================================================
# 5) Heuristic “cause” tagging for opponent runs
# =========================================================
tag_run_cause <- function(tl, runs_tbl) {
if (nrow(runs_tbl) == 0) return(runs_tbl %>% mutate(cause = character()))
turnover_pat <- regex("turnover|bad pass|steal", ignore_case = TRUE)
oreb_pat     <- regex("offensive rebound|o-reb|\\boreb\\b", ignore_case = TRUE)
ft_pat       <- regex("free throw|\\bft\\b", ignore_case = TRUE)
late_shot_pat<- regex("jump shot|3-pt|3pt|three point|missed jumper", ignore_case = TRUE)
sub_pat      <- regex("substitution|sub in|sub out|enters the game|leaves the game", ignore_case = TRUE)
runs_tbl %>%
mutate(
window = purrr::map(
start_sec,
~ tl %>% dplyr::filter(game_sec <= .x, game_sec >= (.x - 45))
),
window_txt = purrr::map_chr(window, ~ paste(.x$event_text, collapse = " | ")),
cause = dplyr::case_when(
str_detect(window_txt, turnover_pat) ~ "UC turnover → transition",
str_detect(window_txt, oreb_pat)     ~ "Def rebounding failure (O-board)",
str_detect(window_txt, ft_pat)       ~ "Foul/FT sequence (opponent bonus)",
str_detect(window_txt, sub_pat)      ~ "Substitution window (stagnation)",
str_detect(window_txt, late_shot_pat)~ "UC drought (late-clock shots)",
TRUE                                 ~ "Other / mixed"
)
) %>%
select(-window, -window_txt)
}
# =========================================================
# 6) Charts
# =========================================================
plot_margin_with_runs <- function(tl, runs_tbl, game_name) {
p <- ggplot(tl, aes(x = game_min, y = margin)) +
geom_hline(yintercept = 0) +
geom_line() +
labs(
title = paste0(game_name, " — Score Margin (UC Davis minus Opponent)"),
x = "Game minutes elapsed",
y = "Margin"
)
if (nrow(runs_tbl) > 0) {
p <- p +
geom_rect(
data = runs_tbl,
aes(xmin = start_min, xmax = end_min, ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
alpha = 0.15
) +
geom_text(
data = runs_tbl,
aes(
x = (start_min + end_min) / 2,
y = max(tl$margin, na.rm = TRUE),
label = paste0("OPP +", points)
),
inherit.aes = FALSE,
vjust = -0.5,
size = 3
)
}
p
}
plot_run_causes <- function(cause_tbl) {
ggplot(cause_tbl, aes(x = reorder(cause, -points), y = points)) +
geom_col() +
coord_flip() +
labs(
title = "Opponent Run Causes (Aggregate)",
x = "Cause (heuristic)",
y = "Opponent run points"
)
}
plot_sub_activity_around_runs <- function(tl, runs_tbl, game_name) {
sub_pat <- regex("substitution|sub in|sub out|enters the game|leaves the game", ignore_case = TRUE)
subs <- tl %>%
filter(str_detect(event_text, sub_pat)) %>%
select(game_min, event_text)
if (nrow(subs) == 0 || nrow(runs_tbl) == 0) return(NULL)
ggplot() +
geom_rect(
data = runs_tbl,
aes(xmin = start_min, xmax = end_min, ymin = 0, ymax = 1),
alpha = 0.15
) +
geom_point(
data = subs,
aes(x = game_min, y = 0.5),
size = 2
) +
labs(
title = paste0(game_name, " — Substitution Events vs Opponent Runs"),
x = "Game minutes elapsed",
y = ""
) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
}
# =========================================================
# 7) Run everything
# =========================================================
all_runs <- list()
for (f in pdf_files) {
message("Processing: ", basename(f))
raw <- read_pdf_lines(f)
pbp <- filter_pbp_lines(raw)
if (nrow(pbp) < 20) {
message("  -> Not enough play-by-play-like lines detected; skipping.")
next
}
events <- parse_pbp_lines(pbp)
if (nrow(events) < 20) {
message("  -> Parsed too few events; skipping.")
next
}
tl <- build_timeline(events)
det <- detect_opponent_runs(tl, min_points = RUN_MIN_POINTS, gap_max_seconds = GAP_MAX_SECONDS)
runs_tbl <- det$runs
runs_tbl <- tag_run_cause(tl, runs_tbl) %>%
mutate(game = tools::file_path_sans_ext(basename(f)))
all_runs[[basename(f)]] <- runs_tbl
# ---- Per-game charts + export
game_name <- tools::file_path_sans_ext(basename(f))
p1 <- plot_margin_with_runs(tl, runs_tbl, game_name)
# IMPORTANT for Rmd: print plot so it renders inline
print(p1)
ggsave(
filename = file.path(OUT_DIR, paste0(game_name, "_margin_runs.png")),
plot = p1, width = 10, height = 5, dpi = 200
)
p2 <- plot_sub_activity_around_runs(tl, runs_tbl, game_name)
if (!is.null(p2)) {
print(p2)  # IMPORTANT for Rmd
ggsave(
filename = file.path(OUT_DIR, paste0(game_name, "_subs_vs_runs.png")),
plot = p2, width = 10, height = 3.2, dpi = 200
)
}
write_csv(runs_tbl, file.path(OUT_DIR, paste0(game_name, "_opponent_runs.csv")))
}
all_runs_df <- bind_rows(all_runs)
# Aggregate cause chart + exports
if (nrow(all_runs_df) > 0) {
cause_tbl <- all_runs_df %>%
group_by(cause) %>%
summarize(points = sum(points), .groups = "drop")
p_cause <- plot_run_causes(cause_tbl)
# Print aggregate chart (Rmd)
print(p_cause)
ggsave(
filename = file.path(OUT_DIR, "aggregate_opponent_run_causes.png"),
plot = p_cause, width = 10, height = 5.5, dpi = 200
)
write_csv(all_runs_df, file.path(OUT_DIR, "ALL_opponent_runs.csv"))
}
message("Done. Outputs written to: ", OUT_DIR)
